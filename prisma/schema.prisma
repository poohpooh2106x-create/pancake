datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model Customer {
  id                String          @id @default(uuid())
  pancakeCustomerId String          @unique
  pageId            String?
  platform          String          @default("FACEBOOK") // FACEBOOK, LINE, WEB, TIKTOK, MANUAL
  leadSource        String?         @default("FB เคพีศรีราชา") // FB เคพีศรีราชา, TikTok, LOA เคพี, etc.
  name              String
  avatarUrl         String?
  profileUrl        String?
  gender            String?
  primaryPhone      String?
  interestedVehicle String?         // หัวลาก, ตู้10, หาง, ดั้ม, ฯลฯ
  assignedSales     String?         // วุธ, อั๋น, ท้อป, จิ๊บ, เกด, ม่า, ปุ๊ก, เฟิร์น
  receivedDate      String?         // เช่น 19/8/2026
  receivedTime      String?         // เช่น 11:24
  assignedAdminName String?
  assignedAdminId   String?
  leadStatus        String          @default("NEW") // NEW, ASSIGNED, CONTACTED, CLOSED, LOST
  tags              String          @default("[]") // JSON string of tags
  notes             String?
  firstContactAt    DateTime        @default(now())
  lastContactAt     DateTime        @default(now())
  totalMessages     Int             @default(0)
  totalOrders       Int             @default(0)
  totalSpent        Float           @default(0.0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  phones            CustomerPhone[]
  messages          Message[]
  orders            Order[]

  @@index([primaryPhone])
  @@index([platform])
  @@index([assignedSales])
  @@index([leadSource])
  @@index([lastContactAt])
}

model CustomerPhone {
  id              String    @id @default(uuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phoneNumber     String    // Normalized Thai format e.g. 0812345678
  e164Format      String?   // +66812345678
  rawExtracted    String    // Raw string found in chat
  carrier         String?   // AIS, TRUE, DTAC, NT
  isPrimary       Boolean   @default(false)
  sourceMessageId String?
  createdAt       DateTime  @default(now())

  @@unique([customerId, phoneNumber])
  @@index([phoneNumber])
}

model Message {
  id                String    @id @default(uuid())
  pancakeMessageId  String?   @unique
  conversationId    String
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  senderType        String    // CUSTOMER, ADMIN, BOT
  text              String
  extractedPhones   String    @default("[]") // JSON string array of extracted phones
  sentAt            DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([customerId])
  @@index([sentAt])
}

model Order {
  id              String    @id @default(uuid())
  pancakeOrderId  String    @unique
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderCode       String?
  totalAmount     Float     @default(0.0)
  status          String    // PENDING, CONFIRMED, COMPLETED, CANCELLED
  itemsSummary    String?   // Summary string or JSON of items
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@index([status])
}

model WebhookEventLog {
  id               String    @id @default(uuid())
  eventId          String?
  pageId           String?
  eventType        String
  platform         String?
  payload          String    // Stored as JSON string
  status           String?   @default("SUCCESS") // SUCCESS, FAILED
  errorMessage     String?
  processingTimeMs Int?
  isProcessed      Boolean   @default(true)
  receivedAt       DateTime  @default(now())

  @@index([eventType])
  @@index([receivedAt])
}
