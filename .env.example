# ==============================================================================
# Pancake Customer Data Extraction & Management Service - Environment Variables
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Database Configuration (SQLite by default for zero-setup, PostgreSQL ready)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/pancake_db?schema=public
DATABASE_URL="file:./dev.db"

# Pancake Integration Settings
# Webhook Secret Token / HMAC Secret key configured in Pancake Chat / POS settings
PANCAKE_WEBHOOK_SECRET="your_pancake_webhook_secret_key_here"
# Pancake Open API Access Token (for historical sync & fallback polling)
PANCAKE_API_ACCESS_TOKEN="your_pancake_api_access_token_here"
PANCAKE_API_BASE_URL="https://pages.fm/api/v1"
PANCAKE_PAGE_IDS="page_id_1,page_id_2"

# Google Sheets Integration Settings (Service Account)
# Enable or disable direct sync to Google Sheets
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_spreadsheet_id_here"
GOOGLE_SHEETS_SHEET_NAME="Pancake Customers"
GOOGLE_SERVICE_ACCOUNT_EMAIL="pancake-sync@your-project.iam.gserviceaccount.com"
# Note: Escape newlines in private key with \n or provide raw private key
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Polling & Fallback Sync Scheduler (Cron format)
# Default: Runs every 30 minutes (*/30 * * * *)
FALLBACK_SYNC_ENABLED=true
FALLBACK_SYNC_CRON="*/30 * * * *"
