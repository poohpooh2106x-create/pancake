# ==============================================================================
# Pancake Customer Data Extraction & Management Service - Local Configuration
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Default SQLite database for instant local prototyping
DATABASE_URL="file:./dev.db"

# Pancake Webhook Secret for HMAC verification (Set same secret in Pancake UI)
PANCAKE_WEBHOOK_SECRET="local_dev_pancake_secret_key"
PANCAKE_API_ACCESS_TOKEN=""
PANCAKE_API_BASE_URL="https://pages.fm/api/v1"
PANCAKE_PAGE_IDS=""

# Google Sheets Sync (Set true when Google Service Account is configured)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SHEETS_SHEET_NAME="Pancake Customers"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Fallback Sync Scheduler
FALLBACK_SYNC_ENABLED=false
FALLBACK_SYNC_CRON="*/30 * * * *"
